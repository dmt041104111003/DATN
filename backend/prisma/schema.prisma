generator client {
  provider     = "prisma-client-js"
  output       = "../node_modules/.prisma/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  address      String   @unique @map("address") // wallet address
  walletName   String?  @map("wallet_name")

  // 
  displayName  String?  @map("display_name")
  location     String?  @map("location")
  gpsLatitude  Float?   @map("gps_latitude")
  gpsLongitude Float?   @map("gps_longitude")

  roles        UserRole[]
  media        Media[]
  products     Product[]
  suppliers    Supplier[]
  materials    Material[]
  walletNonces WalletNonce[]
  subscriptions Subscription[]

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("user")
}

model Role {
  id    String   @id @default(cuid())
  code  RoleCode @unique
  name  String

  users UserRole[]

  @@map("role")
}

enum RoleCode {
  ENTERPRISE
  AGENT
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_role")
}


model WalletNonce {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  address   String   @unique @map("address")
  nonce     String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallet_nonce")
}


model Media {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")

  name      String
  type      String
  url       String   @unique

  // hash(url + type)
  mediaHash String   @map("media_hash")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id])

  @@map("media")
}

model Product {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") // doanh nghiệp

  // NFT identity
  policyId  String   @map("policy_id")
  assetName String   @map("asset_name")

  name      String

  // Hash roots – khớp on-chain
  materialsRoot      String   @map("materials_root")
  certificationsRoot String   @map("certifications_root")
  mediaRoot          String   @map("media_root")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id])
  certifications   Certification[]
  productMaterials ProductMaterial[]

  @@map("product")
}

model Certification {
  id         String    @id @default(cuid())
  productId  String    @map("product_id")

  certName   String
  issueDate  DateTime
  expiryDate DateTime?

  // hash(certName + issueDate + expiryDate)
  certHash   String   @map("cert_hash")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product    Product  @relation(fields: [productId], references: [id])

  @@map("certification")
}


model Supplier {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")

  name           String
  location       String?
  gpsCoordinates String?
  contactInfo    String?

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user           User     @relation(fields: [userId], references: [id])
  materials      Material[]

  @@map("supplier")
}
model Material {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  supplierId   String   @map("supplier_id")

  name         String
  harvestDate  DateTime?

  // hash(materialId + supplierId + harvestDate)
  materialHash String   @map("material_hash")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User     @relation(fields: [userId], references: [id])
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  productMaterials ProductMaterial[]

  @@map("raw_material")
}
model ProductMaterial {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  materialId String   @map("material_id")

  quantity   Float
  unit       String?

  // hash(materialId + quantity + unit)
  pmHash     String   @map("pm_hash")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id])

  @@unique([productId, materialId])
  @@map("product_material")
}

model Service {
  id           String         @id @default(cuid())
  name         String
  description  String?        @map("description")
  price        Float
  duration     Int
  maxProducts  Int?           @map("max_products")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  subscriptions Subscription[]

  @@map("service_plan")
}

model Subscription {
  id            String            @id @default(cuid())
  userId        String            @map("user_id")
  servicePlanId String            @map("service_plan_id")
  startDate     DateTime          @map("start_date")
  endDate       DateTime          @map("end_date")
  status        SubscriptionStatus @default(active)
  amount        Float             @map("amount")
  currency      String            @default("ADA") @map("currency")
  txHash        String?           @map("tx_hash")
  paymentDate   DateTime          @map("payment_date")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  user          User              @relation(fields: [userId], references: [id])
  service       Service            @relation(fields: [servicePlanId], references: [id])

  @@index([userId, status])
  @@index([userId, servicePlanId, status])
  @@index([status, endDate])
  @@index([txHash])
  @@map("subscription")
}

enum SubscriptionStatus {
  pending
  active
  expired
  cancelled
}
