generator client {
  provider     = "prisma-client-js"
  output       = "../node_modules/.prisma/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(cuid())
  address      String         @unique @map("address")
  walletName   String?        @map("wallet_name")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  media        Media[]
  products     Product[]
  subscriptions Subscription[]
  suppliers    Supplier[]
  materials    Material[]
  walletNonces WalletNonce[]

  @@map("user")
}

model WalletNonce {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  address   String   @unique @map("address")
  nonce     String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallet_nonce")
}

model Media {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    String   @map("user_id")
  name      String
  type      String
  url       String   @unique
  user      User     @relation(fields: [userId], references: [id])

  @@map("media")
}

model Product {
  id                  String              @id @default(cuid())
  userId              String              @map("user_id")
  policyId            String?             @map("policy_id")
  assetName           String?             @map("asset_name")
  name                String              @map("name")
  historyHash         String?             @map("history_hash")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  user                User                @relation(fields: [userId], references: [id])
  certifications      Certification[]
  productMaterials    ProductMaterial[]

  @@map("product")
}

model Supplier {
  id             String     @id @default(cuid())
  userId         String     @map("user_id")
  name           String     @map("name")
  location       String?    @map("location")
  gpsCoordinates String?    @map("gps_coordinates")
  contactInfo    String?    @map("contact_info")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  user           User       @relation(fields: [userId], references: [id])
  materials      Material[]

  @@map("supplier")
}

model Material {
  id               String            @id @default(cuid())
  userId           String            @map("user_id")
  supplierId       String            @map("supplier_id")
  name             String            @map("name")
  harvestDate      DateTime?         @map("harvest_date")
  quantity         Float             @map("quantity")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  user             User              @relation(fields: [userId], references: [id])
  supplier         Supplier          @relation(fields: [supplierId], references: [id])
  productMaterials ProductMaterial[]

  @@map("raw_material")
}

model ProductMaterial {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  materialId  String   @map("material_id")
  quantity    Float    @default(0)
  unit        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  material    Material @relation(fields: [materialId], references: [id])

  @@unique([productId, materialId])
  @@map("product_material")
}

model Service {
  id           String         @id @default(cuid())
  name         String
  description  String?        @map("description")
  price        Float
  duration     Int
  maxProducts  Int?           @map("max_products")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  subscriptions Subscription[]

  @@map("service_plan")
}

model Subscription {
  id            String            @id @default(cuid())
  userId        String            @map("user_id")
  servicePlanId String            @map("service_plan_id")
  startDate     DateTime          @map("start_date")
  endDate       DateTime          @map("end_date")
  status        SubscriptionStatus @default(active)
  amount        Float             @map("amount")
  currency      String            @default("ADA") @map("currency")
  txHash        String?           @map("tx_hash")
  paymentDate   DateTime          @map("payment_date")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  user          User              @relation(fields: [userId], references: [id])
  service       Service            @relation(fields: [servicePlanId], references: [id])

  @@index([userId, status])
  @@index([userId, servicePlanId, status])
  @@index([status, endDate])
  @@index([txHash])
  @@map("subscription")
}

enum SubscriptionStatus {
  pending
  active
  expired
  cancelled
}

model Certification {
  id         String    @id @default(cuid())
  productId  String    @map("product_id")
  certName   String    @map("cert_name")
  issueDate  DateTime  @map("issue_date")
  expiryDate DateTime? @map("expiry_date")
  certHash   String?   @map("cert_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  product    Product   @relation(fields: [productId], references: [id])

  @@map("certification")
}

