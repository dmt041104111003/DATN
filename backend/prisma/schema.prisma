generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  address   String    @unique
  lastLogin DateTime?
  roleCode  String
  role      Role      @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  displayName String?
  phoneNumber String?
  isActive  Boolean   @default(true)
  productions Production[]
  containers  Container[]
  warehouse   Warehouse?
  media     Media[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([roleCode])
}

model WalletNonce {
  id        String   @id @default(cuid())
  address   String
  nonce     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([address])
  @@index([address])
  @@index([expiresAt])
  @@index([usedAt])
}

model Role {
  code      String   @id
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts  User[]
}

model Production {
  id                          String   @id @default(cuid())
  traceSchemeRef              String
  inventoryKey                String   @unique
  code                        String   @unique
  registeringCustodianAddress String
  registeringCustodian        User? @relation(fields: [registeringCustodianAddress], references: [address], onDelete: Restrict)

  facilityId                  String
  location                    String
  farmingMethod               String
  cropType                    String
  varietyId                   String?
  customVariety               String?
  seedingDate                 DateTime
  harvestDate                 DateTime?
  expectedYieldKg             String?
  actualYieldKg               String?
  status                      ProductionStage @default(CREATED)

  certifications              String?
  customCertificationName     String?
  note                        String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  recordOperations RecordOperation[] @relation("ProductionRecordOperations")
  containers      Container[]

  @@index([registeringCustodianAddress])
}

model Container {
  id                          String   @id @default(cuid())
  traceSchemeRef              String
  inventoryKey                String   @unique
  code                        String   @unique
  productionInventoryKey      String
  production                  Production @relation(fields: [productionInventoryKey], references: [inventoryKey], onDelete: Restrict)
  registeringCustodianAddress String
  registeringCustodian        User? @relation(fields: [registeringCustodianAddress], references: [address], onDelete: Restrict)
  location                    String?
  containerType               String?
  capacityKg                  String?
  actualCapacityKg            String?
  productName                 String?
  participantWalletAddresses  String   @default("[]")
  participantLocationLabels   String   @default("")
  note                        String?
  status                      ContainerStage @default(CREATE)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  recordOperations            RecordOperation[] @relation("ContainerRecordOperations")
  warehouseStorages           WarehouseStorage[]

  @@index([productionInventoryKey])
  @@index([registeringCustodianAddress])
}

model Warehouse {
  id                          String   @id @default(cuid())
  name                        String
  location                    String
  capacity                    String
  registeringCustodianAddress String
  registeringCustodian        User?    @relation(fields: [registeringCustodianAddress], references: [address], onDelete: Restrict)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  storages                    WarehouseStorage[]

  @@unique([registeringCustodianAddress])
}

model WarehouseStorage {
  id                    String    @id @default(cuid())
  containerInventoryKey String
  warehouseId           String
  conditions            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  container             Container @relation(fields: [containerInventoryKey], references: [inventoryKey], onDelete: Cascade)
  warehouse             Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([containerInventoryKey])
  @@index([warehouseId])
}

enum ProductionStage {
  CREATED
  UPDATED
  CLOSED
}

enum ContainerStage {
  CREATE
  UPDATE
}

model RecordOperation {
  id          String   @id @default(cuid())
  entityType  String
  entityKey   String
  opType      String
  txHash      String
  verified    Boolean  @default(false)
  verifiedAt  DateTime?
  payload     Json?
  attempts    Int      @default(0)
  lastCheckedAt DateTime?
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productionInventoryKey String?
  production         Production? @relation("ProductionRecordOperations", fields: [productionInventoryKey], references: [inventoryKey], onDelete: Cascade)
  containerInventoryKey String?
  container         Container? @relation("ContainerRecordOperations", fields: [containerInventoryKey], references: [inventoryKey], onDelete: Cascade)

  @@index([entityType, entityKey])
  @@index([verified, createdAt])
  @@index([entityType, entityKey, createdAt])
  @@index([productionInventoryKey])
  @@index([containerInventoryKey])
}

model Media {
  id              String   @id @default(cuid())
  ipfsUri         String   @unique
  ipfsHash        String?
  url             String?
  name            String?
  mimeType        String?
  sizeBytes       Int?
  createdByAddress String?
  createdBy       User? @relation(fields: [createdByAddress], references: [address], onDelete: SetNull)
  createdAt       DateTime @default(now())

  links           EntityMedia[]
}

model EntityMedia {
  id          String   @id @default(cuid())
  entityType  String
  entityKey   String
  role        String

  mediaId     String
  media       Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([entityType, entityKey])
  @@index([role])
  @@unique([entityType, entityKey, role])
}
