generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CustodianAccount {
  id        String    @id @default(cuid())
  address   String    @unique
  lastLogin DateTime?
  roleCode  String?
  role      Role?     @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  displayName String?
  location  String?
  isActive  Boolean   @default(true)
  containers Container[]
  growingAreas GrowingArea[]
  plans     Plan[]
  productions Production[]
  media     Media[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([roleCode])
}

model Unit {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  unitType        UnitType
  walletAddress   String   @unique
  provinceId      String
  districtId      String
  wardId          String
  detailAddress   String?
  contactName     String?
  phoneNumber     String?
  createdByAddress String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdByAddress])
}

enum UnitType {
  TRANSIT
  AGENT
}

model WalletNonce {
  id        String   @id @default(cuid())
  address   String
  nonce     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([address])
  @@index([address])
  @@index([expiresAt])
  @@index([usedAt])
}

model Role {
  code      String   @id
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts  CustodianAccount[]
}

model Container {
  id                          String        @id @default(cuid())
  traceSchemeRef              String
  lotReference                String
  inventoryKey                String        @unique
  confirmationRef             String
  custodyRoster               String
  registeringCustodianAddress String
  registeringCustodian        CustodianAccount? @relation(fields: [registeringCustodianAddress], references: [address], onDelete: Restrict)
  planInventoryKey            String?
  plan                        Plan?         @relation(fields: [planInventoryKey], references: [inventoryKey], onDelete: SetNull)
  warehouse                   Warehouse?    @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  warehouseId                 String?
  tradeTitle                  String
  lotStory                    String
  roadmap                     String?
  location                    String?
  containerType               String?
  maxWeightValue              String?
  maxWeightUnit               String?
  maxVolumeValue              String?
  maxVolumeUnit               String?
  status                      ContainerStatus @default(INITIAL)
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt

  @@index([registeringCustodianAddress])
  @@index([planInventoryKey])

  recordOperations RecordOperation[] @relation("ContainerRecordOperations")
}

enum ContainerStatus {
  INITIAL
  UPDATED
  OUTBOUND_DISPATCH
  INBOUND_CHECKIN
  CONSUMED
}

model Warehouse {
  id                   String   @id @default(cuid())
  code                 String
  name                 String
  siteCustodianAddress String
  isActive             Boolean  @default(true)
  maxProducts          Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  containers Container[]

  @@unique([siteCustodianAddress, code])
  @@index([siteCustodianAddress])
}

model GrowingArea {
  id                          String   @id @default(cuid())
  traceSchemeRef              String
  inventoryKey                String   @unique
  custodyRoster               String
  registeringCustodianAddress String
  registeringCustodian        CustodianAccount? @relation(fields: [registeringCustodianAddress], references: [address], onDelete: Restrict)
  name                        String
  location                    String
  areaSize                    String?
  soilType                    String?
  createdAt                   DateTime @default(now())

  plans                       Plan[]

  @@index([registeringCustodianAddress])

  recordOperations RecordOperation[] @relation("GrowingAreaRecordOperations")
}

model Plan {
  id                 String     @id @default(cuid())
  traceSchemeRef      String
  inventoryKey        String     @unique
  growingAreaInventoryKey String
  growingArea        GrowingArea @relation(fields: [growingAreaInventoryKey], references: [inventoryKey], onDelete: Restrict)
  growingAreaSnapshot Json
  containers         Container[]
  nurseryBatch        String
  plantingBatch       String
  cropType            String
  nurseryArea         String
  plantingArea        String
  seedQuantityValue   String
  seedQuantityUnit    String
  plantQuantityValue  String
  plantQuantityUnit   String

  createdBy           String
  creator             CustodianAccount? @relation(fields: [createdBy], references: [address], onDelete: Restrict)
  plannedSeedingDate  DateTime
  plannedPlantingDate DateTime

  plannedHarvestDate         DateTime?
  expectedHarvestYield       String?
  plannedProcessingDate      DateTime?
  expectedProcessingYield    String?
  plannedPackagingDate       DateTime?
  expectedPackagingQuantity  String?
  expiryDate                 DateTime?
  packagingSpec              String?

  stage              PlanStage @default(PLANNED)
  harvestedAt         DateTime?
  packagedAt          DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([createdBy])
  @@index([growingAreaInventoryKey])

  recordOperations RecordOperation[] @relation("PlanRecordOperations")
}

model Production {
  id                          String   @id @default(cuid())
  traceSchemeRef              String
  inventoryKey                String   @unique
  code                        String   @unique
  registeringCustodianAddress String
  registeringCustodian        CustodianAccount? @relation(fields: [registeringCustodianAddress], references: [address], onDelete: Restrict)

  facilityId                  String
  provinceId                  String
  districtId                  String
  wardId                      String
  farmingMethod               String
  cropType                    String
  varietyId                   String?
  customVariety               String?
  seedingDate                 DateTime
  harvestDate                 DateTime?
  expectedYieldKg             String?
  actualYieldKg               String?
  status                      ProductionStage @default(ACTIVE)

  certifications              String?
  customCertificationName     String?
  note                        String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  recordOperations RecordOperation[] @relation("ProductionRecordOperations")

  @@index([registeringCustodianAddress])
}

enum ProductionStage {
  ACTIVE
  CLOSED
}

enum PlanStage {
  PLANNED
  HARVESTED
  PACKAGED
}

model RecordOperation {
  id          String   @id @default(cuid())
  entityType  String
  entityKey   String
  opType      String
  txHash      String
  verified    Boolean  @default(false)
  verifiedAt  DateTime?
  payload     Json?
  attempts    Int      @default(0)
  lastCheckedAt DateTime?
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Optional FKs for clean ERD + enforced integrity
  containerInventoryKey String?
  container             Container? @relation("ContainerRecordOperations", fields: [containerInventoryKey], references: [inventoryKey], onDelete: Cascade)
  planInventoryKey    String?
  plan                Plan?    @relation("PlanRecordOperations", fields: [planInventoryKey], references: [inventoryKey], onDelete: Cascade)
  growingAreaInventoryKey String?
  growingArea         GrowingArea? @relation("GrowingAreaRecordOperations", fields: [growingAreaInventoryKey], references: [inventoryKey], onDelete: Cascade)
  productionInventoryKey String?
  production         Production? @relation("ProductionRecordOperations", fields: [productionInventoryKey], references: [inventoryKey], onDelete: Cascade)

  @@index([entityType, entityKey])
  @@index([verified, createdAt])
  @@index([entityType, entityKey, createdAt])
  @@index([containerInventoryKey])
  @@index([planInventoryKey])
  @@index([growingAreaInventoryKey])
  @@index([productionInventoryKey])
}

model Media {
  id              String   @id @default(cuid())
  ipfsUri         String   @unique
  ipfsHash        String?
  url             String?
  name            String?
  mimeType        String?
  sizeBytes       Int?
  createdByAddress String?
  createdBy       CustodianAccount? @relation(fields: [createdByAddress], references: [address], onDelete: SetNull)
  createdAt       DateTime @default(now())

  links           EntityMedia[]
}

model EntityMedia {
  id          String   @id @default(cuid())
  entityType  String
  entityKey   String
  role        String

  mediaId     String
  media       Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([entityType, entityKey])
  @@index([role])
  @@unique([entityType, entityKey, role])
}
