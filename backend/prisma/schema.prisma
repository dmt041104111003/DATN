generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  address   String    @unique
  lastLogin DateTime?
  roleCode  String?
  role      Role?     @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  displayName String?
  phoneNumber String?
  provinceId String?
  districtId String?
  wardId   String?
  isActive  Boolean   @default(true)
  productions Production[]
  packages  Package[]
  shipments Shipment[]
  media     Media[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([roleCode])
}

model WalletNonce {
  id        String   @id @default(cuid())
  address   String
  nonce     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([address])
  @@index([address])
  @@index([expiresAt])
  @@index([usedAt])
}

model Role {
  code      String   @id
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts  User[]
}

model Production {
  id                          String   @id @default(cuid())
  traceSchemeRef              String
  inventoryKey                String   @unique
  code                        String   @unique
  registeringCustodianAddress String
  registeringCustodian        User? @relation(fields: [registeringCustodianAddress], references: [address], onDelete: Restrict)

  facilityId                  String
  provinceId                  String
  districtId                  String
  wardId                      String
  farmingMethod               String
  cropType                    String
  varietyId                   String?
  customVariety               String?
  seedingDate                 DateTime
  harvestDate                 DateTime?
  expectedYieldKg             String?
  actualYieldKg               String?
  status                      ProductionStage @default(ACTIVE)

  certifications              String?
  customCertificationName     String?
  note                        String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  recordOperations RecordOperation[] @relation("ProductionRecordOperations")
  packages         Package[]

  @@index([registeringCustodianAddress])
}

model Package {
  id                     String        @id @default(cuid())
  traceSchemeRef         String
  inventoryKey           String        @unique
  code                   String        @unique
  registeringCustodianAddress String
  registeringCustodian   User?         @relation(fields: [registeringCustodianAddress], references: [address], onDelete: Restrict)
  holderAddress          String
  productionInventoryKey String
  production             Production    @relation(fields: [productionInventoryKey], references: [inventoryKey], onDelete: Restrict)
  shipmentLinks          ShipmentPackage[]
  weightValue            Float
  weightUnit             String
  quantity               Int
  packagingType          String
  packagingDate          DateTime
  note                   String?
  authorizedAgents       Json
  status                 PackageStatus @default(UNSOLD)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([registeringCustodianAddress])
  @@index([holderAddress])
  @@index([productionInventoryKey])
}

model Shipment {
  id                          String         @id @default(cuid())
  traceSchemeRef              String
  inventoryKey                String         @unique
  code                        String         @unique
  registeringCustodianAddress String
  registeringCustodian        User?          @relation(fields: [registeringCustodianAddress], references: [address], onDelete: Restrict)
  holderAddress               String
  location                    String
  updaterAddresses            Json
  roadmap                     Json
  status                      ShipmentStatus @default(IN_TRANSIT)
  note                        String?
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt

  packages ShipmentPackage[]

  @@index([registeringCustodianAddress])
  @@index([holderAddress])
}

model ShipmentPackage {
  id                    String   @id @default(cuid())
  shipmentInventoryKey  String
  shipment              Shipment @relation(fields: [shipmentInventoryKey], references: [inventoryKey], onDelete: Cascade)
  packageInventoryKey   String   @unique
  package               Package  @relation(fields: [packageInventoryKey], references: [inventoryKey], onDelete: Restrict)
  createdAt             DateTime @default(now())

  @@index([shipmentInventoryKey])
}

enum PackageStatus {
  UNSOLD
  SOLD
}

enum ShipmentStatus {
  CREATED
  IN_TRANSIT
  DELIVERED
}

enum ProductionStage {
  ACTIVE
  CLOSED
}

model RecordOperation {
  id          String   @id @default(cuid())
  entityType  String
  entityKey   String
  opType      String
  txHash      String
  verified    Boolean  @default(false)
  verifiedAt  DateTime?
  payload     Json?
  attempts    Int      @default(0)
  lastCheckedAt DateTime?
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productionInventoryKey String?
  production         Production? @relation("ProductionRecordOperations", fields: [productionInventoryKey], references: [inventoryKey], onDelete: Cascade)

  @@index([entityType, entityKey])
  @@index([verified, createdAt])
  @@index([entityType, entityKey, createdAt])
  @@index([productionInventoryKey])
}

model Media {
  id              String   @id @default(cuid())
  ipfsUri         String   @unique
  ipfsHash        String?
  url             String?
  name            String?
  mimeType        String?
  sizeBytes       Int?
  createdByAddress String?
  createdBy       User? @relation(fields: [createdByAddress], references: [address], onDelete: SetNull)
  createdAt       DateTime @default(now())

  links           EntityMedia[]
}

model EntityMedia {
  id          String   @id @default(cuid())
  entityType  String
  entityKey   String
  role        String

  mediaId     String
  media       Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([entityType, entityKey])
  @@index([role])
  @@unique([entityType, entityKey, role])
}
