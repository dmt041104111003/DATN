// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Wallet {
  id        String   @id @default(cuid())
  address   String   @unique
  lastLogin DateTime
  profiles  Profile[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

model Profile {
  id          String   @id @default(cuid())
  wallet      Wallet   @relation(fields: [walletAddress], references: [address], onDelete: Cascade)
  walletAddress String
  roleCode    String
  displayName String
  location    String?
  avatarUrl   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([walletAddress, roleCode])
  @@map("profiles")
}

model Asset {
  id                 String   @id @default(cuid())
  policyId           String
  assetName          String
  unit               String   @unique
  txHash             String
  owners             String
  ownerWalletAddress String
  warehouse          Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  warehouseId        String?
  name               String
  description        String
  brand              String?
  model              String?
  material           String?
  battery            String?
  image              String?
  mediaType          String?
  roadmap            String?
  location           String?
  quantity           String   @default("")
  quantityUnit       String   @default("")
  notes              String?
  status             AssetStatus @default(ACTIVE)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([ownerWalletAddress])
  @@map("assets")
}

enum AssetStatus {
  ACTIVE
  CONSUMED
}

model Warehouse {
  id                 String   @id @default(cuid())
  code               String
  name               String
  ownerWalletAddress String
  isActive           Boolean  @default(true)
  maxAssets          Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  assets    Asset[]

  @@unique([ownerWalletAddress, code])
  @@index([ownerWalletAddress])
  @@map("warehouses")
}

enum OrderStatus {
  PENDING
  SHIPPED
  RECEIVED
  CANCELLED
}

model Order {
  id                   String      @id @default(cuid())
  assetUnit             String
  policyId              String
  assetName             String
  senderWalletAddress   String
  receiverWalletAddress String
  txHash                String?
  status                OrderStatus @default(PENDING)
  receiverWarehouseId   String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([senderWalletAddress])
  @@index([receiverWalletAddress])
  @@index([assetUnit])
  @@map("orders")
}

model AssetImage {
  id        String   @id @default(cuid())
  ownerWalletAddress String
  name      String
  mimeType  String
  ipfsHash  String
  url       String
  createdAt DateTime @default(now())

  @@index([ownerWalletAddress])
  @@map("asset_images")
}

model Producer {
  id                 String   @id @default(cuid())
  ownerWalletAddress String
  name               String
  code               String?
  location           String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([ownerWalletAddress])
  @@map("producers")
}

model ProductType {
  id                 String   @id @default(cuid())
  ownerWalletAddress String
  name               String
  code               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([ownerWalletAddress])
  @@map("product_types")
}

model Certification {
  id                 String   @id @default(cuid())
  ownerWalletAddress String
  name               String
  issuer             String?
  certCode           String?
  validFrom          DateTime?
  validTo            DateTime?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([ownerWalletAddress])
  @@map("certifications")
}
