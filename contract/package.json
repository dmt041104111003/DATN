{
  "name": "traceability-contract-cli",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "mint": "tsx ./cli/mint.ts",
    "update": "tsx ./cli/update.ts",
    "burn": "tsx ./cli/burn.ts",
    "product": "tsx ./cli/product.ts",
    "tracking": "tsx ./cli/tracking.ts",
    "contract:fmt": "cd ./contract && aiken fmt",
    "contract:test": "cd ./contract && aiken check",
    "contract:build": "cd ./contract && aiken build",
    "test": "jest"
  },
  "dependencies": {
    "@blockfrost/blockfrost-js": "^6.1.1",
    "@meshsdk/core": "^1.9.0-beta.104",
    "cbor": "^10.0.11",
    "chalk": "^5.6.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "dotenv": "^17.2.3",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.19.4",
    "typescript": "^5"
  }
}
